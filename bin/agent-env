#!/usr/bin/env bash
# agent-env — print a machine snapshot for AI coding agents to read as ground truth.
#
# Every probe is gated on tool availability, so the script is safe to run on any
# host: a fresh Mac, a Pi, a Fedora workstation. Absent tools are skipped silently.
#
# Output is markdown-flavored for easy LLM parsing and human readability.
# Source: https://github.com/elleryfamilia/agent-config

set -u

print_section() { printf '\n## %s\n' "$1"; }

detect_os() {
    case "$(uname -s 2>/dev/null || echo unknown)" in
        Darwin) echo "macOS" ;;
        Linux)  echo "Linux" ;;
        *)      uname -s 2>/dev/null || echo unknown ;;
    esac
}

distro_info() {
    if [ -r /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        printf '%s %s' "${NAME:-Linux}" "${VERSION_ID:-}"
    elif command -v sw_vers >/dev/null 2>&1; then
        printf 'macOS %s (build %s)' \
            "$(sw_vers -productVersion 2>/dev/null)" \
            "$(sw_vers -buildVersion 2>/dev/null)"
    else
        echo unknown
    fi
}

uptime_short() {
    command -v uptime >/dev/null 2>&1 || return 0
    uptime | sed -E 's/^[^,]*up //; s/,[[:space:]]+[0-9]+ users?.*$//; s/,[[:space:]]+load[[:space:]]+average.*$//'
}

print_host() {
    print_section "Host"
    printf 'hostname:  %s\n' "$(hostname 2>/dev/null || echo unknown)"
    printf 'user:      %s\n' "${USER:-$(id -un 2>/dev/null || echo unknown)}"
    printf 'os:        %s\n' "$(detect_os)"
    printf 'distro:    %s\n' "$(distro_info)"
    printf 'arch:      %s\n' "$(uname -m 2>/dev/null || echo unknown)"
    printf 'kernel:    %s\n' "$(uname -r 2>/dev/null || echo unknown)"
    printf 'shell:     %s\n' "${SHELL:-unknown}"
    up=$(uptime_short) && [ -n "$up" ] && printf 'uptime:    %s\n' "$up"
}

# Tailscale: prints the full `tailscale status` if logged in. Falls back to the
# Mac App Store / direct-download location since Tailscale.app doesn't put the
# CLI on PATH by default. Suppresses errors when not authed or daemon is down.
find_tailscale() {
    if command -v tailscale >/dev/null 2>&1; then command -v tailscale; return; fi
    for p in \
        /Applications/Tailscale.app/Contents/MacOS/Tailscale \
        /opt/homebrew/bin/tailscale \
        /usr/local/bin/tailscale; do
        [ -x "$p" ] && { echo "$p"; return; }
    done
    return 1
}

print_tailscale() {
    local ts
    ts=$(find_tailscale) || return 0
    local out
    out=$("$ts" status 2>/dev/null) || return 0
    [ -n "$out" ] || return 0
    print_section "Tailnet (tailscale status)"
    printf '%s\n' "$out"
}

print_containers() {
    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        print_section "Docker containers"
        docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null || true
    fi
    if command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1; then
        print_section "Podman containers"
        podman ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null || true
    fi
}

# Linux: systemd active services. macOS: skipped (launchctl output is too noisy
# to be useful by default; extend here if you want brew services or launchctl).
print_services() {
    if command -v systemctl >/dev/null 2>&1; then
        print_section "Active systemd services (up to 30)"
        systemctl list-units --state=running --type=service --no-legend --no-pager 2>/dev/null \
            | awk '{print $1}' | head -n 30
    fi
}

# Toolchain versions — light touch, only the ones the AGENTS.md mentions.
print_toolchain() {
    local lines=""
    for tool in node pnpm python3 uv rg fd gh tailscale docker; do
        if command -v "$tool" >/dev/null 2>&1; then
            v=$("$tool" --version 2>/dev/null | head -n1)
            lines+="$(printf '%-10s %s\n' "$tool" "$v")"$'\n'
        fi
    done
    if [ -n "$lines" ]; then
        print_section "Detected toolchain"
        printf '%s' "$lines"
    fi
}

main() {
    printf '# agent-env snapshot (%s UTC)\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    print_host
    print_tailscale
    print_containers
    print_services
    print_toolchain
}

main "$@"
